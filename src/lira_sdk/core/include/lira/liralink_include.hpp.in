#pragma once

#include "lira_protocol/lira_protocol_types.h"

// We provide our own lira_protocol_get_channel_status with controlled storage,
// and export it so that tests can link against it.
#define LIRA_PROTOCOL_GET_CHANNEL_STATUS
#if defined(_WIN32) && defined(LIRASDK_SHARED) && defined(LIRASDK_BUILD)
__declspec(dllexport)
#elif defined(_WIN32) && defined(LIRASDK_SHARED)
__declspec(dllimport)
#elif !defined(_WIN32)
__attribute__((visibility("default")))
#endif
    lira_protocol_status_t* lira_protocol_get_channel_status(uint8_t chan);

#include "lira_protocol/@LIRA_PROTOCOL_DIALECT@/lira_protocol.h"
