#pragma once

#include "liralink/liralink_types.h"

// We provide our own liralink_get_channel_status with controlled storage,
// and export it so that tests can link against it.
#define LIRALINK_GET_CHANNEL_STATUS
#if defined(_WIN32) && defined(LIRASDK_SHARED) && defined(LIRASDK_BUILD)
__declspec(dllexport)
#elif defined(_WIN32) && defined(LIRASDK_SHARED)
__declspec(dllimport)
#elif !defined(_WIN32)
__attribute__((visibility("default")))
#endif
    liralink_status_t* liralink_get_channel_status(uint8_t chan);

#include "liralink/@LIRALINK_DIALECT@/liralink.h"
